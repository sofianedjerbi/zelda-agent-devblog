 "defs": [
  {
   "k": "Progress ladder",
   "v": "the first step a game reaches each goal: first item, second item, a dungeon, a key, using a key (key count drops inside a dungeon), dungeon rooms, map or compass, a heart container (every Zelda boss leaves one), a second dungeon, a fourth item, the ending."
  },
  {
   "k": "Speed",
   "v": "median steps to a goal over the 16 games. One step = 8 frames, the same for every idea."
  },
  {
   "k": "Places",
   "v": "distinct screens, caves and dungeon rooms entered."
  },
  {
   "k": "Hits and hearts lost",
   "v": "health going down while max health stays the same."
  },
  {
   "k": "Heals",
   "v": "health going up without a heart container; 'when low' = it was at half health or less."
  },
  {
   "k": "Longest stall",
   "v": "the most steps in a row with no new place, item, key or heart container."
  },
  {
   "k": "Learning",
   "v": "rate in the second half of the game divided by the first half."
  }
 ],
 "limits": [
  "16 games per idea is small: single games range from about 10 to 70 places. That is why the marks use paired intervals.",
  "These are the games I tune on (seeds 8-23). A winner must also win on 16 held-out games before it becomes the default.",
  "Zelda 1 keeps no kill counter, so combat KPIs are blank for it.",
  "'Heart container' stands for beating a boss. Zelda 1 also has a few on the overworld.",
  "The learning ratio drops when the agent gets stuck late in the game (stuck = no fights). Read it next to the longest stall."
 ]
}